<script>
(function() {
  var SESSION_KEY = 'aisa_v1';
  var APP_URL = {{ block.settings.app_url | json }};

  function getToken() {
    try {
      var t = sessionStorage.getItem(SESSION_KEY);
      if (!t) {
        t = Math.random().toString(36).slice(2) + Date.now().toString(36);
        sessionStorage.setItem(SESSION_KEY, t);
      }
      return t;
    } catch(e) { return 'ns_' + Date.now(); }
  }

  function getUtm() {
    try {
      var p = new URLSearchParams(window.location.search);
      return {
        utmSource: p.get('utm_source'),
        utmMedium: p.get('utm_medium'),
        utmCampaign: p.get('utm_campaign')
      };
    } catch(e) { return {}; }
  }

  function post(path, data) {
    try {
      fetch(APP_URL + path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        credentials: 'omit',
        keepalive: true
      });
    } catch(e) {}
  }

  var token = getToken();
  var utm = getUtm();
  var shop = (window.Shopify && window.Shopify.shop) ? window.Shopify.shop : location.hostname;

  post('/api/session', {
    shopDomain: shop,
    token: token,
    referrer: document.referrer || null,
    utmSource: utm.utmSource || null,
    utmMedium: utm.utmMedium || null,
    utmCampaign: utm.utmCampaign || null,
    landingPage: location.pathname
  });

  document.addEventListener('click', function(e) {
    var t = e.target;
    if (t && (t.closest('[data-add-to-cart]') || t.closest('[name="add"]') || t.closest('.add-to-cart'))) {
      post('/api/event', { token: token, eventType: 'add_to_cart', page: location.pathname });
    }
  }, true);

  document.addEventListener('click', function(e) {
    var t = e.target;
    if (t && (t.closest('[name="checkout"]') || t.closest('[href*="/checkout"]'))) {
      post('/api/event', { token: token, eventType: 'checkout_started', page: location.pathname });
    }
  }, true);
})();
</script>

{% schema %}
{
  "name": "AI Analytics",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://your-app.fly.dev",
      "info": "The URL of your AI Analytics app server."
    }
  ]
}
{% endschema %}
